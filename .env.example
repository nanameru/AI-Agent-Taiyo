# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://api-dashboard.search.brave.com/app/documentation/web-search/get-started
BRAVE_SEARCH_API_KEY=****

# Optional local-only Codex mode.
# Run `codex login` first to use ChatGPT subscription-backed Codex locally.
CODEX_LOCAL_MODE_ENABLED=0
CODEX_LOCAL_MODEL=gpt-5.4
CODEX_LOCAL_SANDBOX=read-only
# CODEX_LOCAL_WORKDIR=/absolute/path/to/workspace
# CODEX_LOCAL_CODEX_HOME=/absolute/path/to/codex-home
# CODEX_LOCAL_NETWORK=0

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# https://docs.convex.dev/auth/authkit
NEXT_PUBLIC_CONVEX_URL=****
CONVEX_DEPLOYMENT=****

# https://workos.com/docs/authkit/nextjs
WORKOS_CLIENT_ID=****
WORKOS_API_KEY=****
WORKOS_COOKIE_PASSWORD=****
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# https://docs.browserbase.com/welcome/introduction
BROWSERBASE_API_KEY=****

# https://html2pptx.app
HTML2PPTX_API_KEY=****
